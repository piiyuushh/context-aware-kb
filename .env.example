# Copy to .env and fill in. Never commit .env.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000

# Postgres. Matches docker-compose.yml.
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# --- Auth (Phase 1) ---
SESSION_SECRET=replace-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Points at the WEB origin on purpose: the browser reaches the API only through
# the Next.js /api/v1 proxy, so the OAuth state cookie stays same-origin.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback
# 32-byte key, hex encoded. Used to encrypt GitHub tokens at rest.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Where the API redirects the browser after a successful OAuth login.
WEB_APP_URL=http://localhost:3000

# --- Web (apps/web) ---
# API origin the Next.js rewrite proxies /api/v1/* to. Read server-side by
# apps/web/next.config.ts; the browser never calls this origin directly.
# Default: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
