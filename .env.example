# Copy to .env and fill in. Never commit .env.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000

# Postgres. Matches docker-compose.yml.
DATABASE_URL=postgresql://kb:kb@localhost:5432/kb

# --- Auth (Phase 1) ---
SESSION_SECRET=replace-me
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
# 32-byte key, hex encoded. Used to encrypt GitHub tokens at rest.
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
