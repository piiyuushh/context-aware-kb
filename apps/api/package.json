{
  "name": "@kb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Express + TypeScript API for the knowledge base.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node-pg-migrate up --envPath ../../.env",
    "db:migrate:down": "node-pg-migrate down --envPath ../../.env",
    "db:migrate:create": "node-pg-migrate create --envPath ../../.env -j ts"
  },
  "dependencies": {
    "@kb/shared": "*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "mdast-util-to-string": "^4.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
